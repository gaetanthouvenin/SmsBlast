<Window x:Class="SmsBlast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmsBlast — envoi de SMS personnalisés via ADB"
        Height="960" Width="1280" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Boutons des barres d'outils : espacés entre eux. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- Pastille de type de numéro dans la grille. -->
        <Style x:Key="KindPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Brush.Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindText}" Value="Mobile">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Fixe">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Étranger">
                    <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Invalide">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KindPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindText}" Value="Mobile">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Fixe">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Étranger">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="Invalide">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Statut d'envoi : couleur selon l'état de la ligne. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="sent">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="sending">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icônes du sélecteur de thème (Segoe MDL2 Assets, présent sur Windows 10/11). -->
        <Style x:Key="SegmentIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,6,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================== En-tête -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="22,10">
            <DockPanel LastChildFill="True">

                <!-- Sélecteur de thème, tout à droite -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Subtle}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="3" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Apparence : suivre Windows, ou forcer le thème clair ou sombre">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbThemeSystem" Tag="System" GroupName="Theme"
                                     Style="{StaticResource Segment}" Checked="Theme_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource SegmentIcon}" />
                                <TextBlock Text="Auto" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="rbThemeLight" Tag="Light" GroupName="Theme"
                                     Style="{StaticResource Segment}" Checked="Theme_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE706;" Style="{StaticResource SegmentIcon}" />
                                <TextBlock Text="Clair" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="rbThemeDark" Tag="Dark" GroupName="Theme"
                                     Style="{StaticResource Segment}" Checked="Theme_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" Style="{StaticResource SegmentIcon}" />
                                <TextBlock Text="Sombre" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- État du relais -->
                <Border DockPanel.Dock="Right" x:Name="pillRelay" Margin="16,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=lblRelayState}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=lblRelayState}" Value="Relais installé sur le téléphone.">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=lblRelayState}" Value="adb injoignable">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=lblRelayState}" Value="Relais installé sur le téléphone.">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=lblRelayState}" Value="adb injoignable">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="lblRelayState" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                </Border>

                <!-- Logo + titre -->
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Brush.Accent}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M4,4 L20,4 A3,3 0 0 1 23,7 L23,16 A3,3 0 0 1 20,19 L10,19 L6,23 L6,19 L4,19 A3,3 0 0 1 1,16 L1,7 A3,3 0 0 1 4,4 Z"
                          Fill="{DynamicResource Brush.OnAccent}" Stretch="Uniform" Width="18" Height="18" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmsBlast" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Envoi de SMS personnalisés depuis un fichier Excel, via un téléphone Android"
                               Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================== Contenu -->
        <Grid Grid.Row="1" Margin="20,16,20,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <!-- Journal : replié, juste son en-tête ; déplié, un tiers de l'espace restant. -->
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, ElementName=expLog}" Value="True">
                                    <Setter Property="Height" Value="0.5*" />
                                    <Setter Property="MinHeight" Value="140" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- 1. Source -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="1" Style="{StaticResource StepBadgeText}" />
                        </Border>
                        <TextBlock Text="Fichier source" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text=".xlsx, .xlsm, .csv ou .txt — une ligne d'en-tête, une ligne par destinataire"
                                   Style="{StaticResource Text.Muted}" Margin="10,0,0,0" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" LastChildFill="True">
                        <Button DockPanel.Dock="Right" x:Name="btnReload" Content="Recharger"
                                Style="{StaticResource ToolButton}" Click="BtnReload_Click" />
                        <Button DockPanel.Dock="Right" x:Name="btnBrowse" Content="Parcourir…"
                                Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Click="BtnBrowse_Click" />
                        <TextBox x:Name="txtFile" IsReadOnly="True" Background="{DynamicResource Brush.Subtle}" />
                    </DockPanel>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" x:Name="lblSourceInfo" Style="{StaticResource Text.Muted}"
                                   TextAlignment="Right" MaxWidth="360" Margin="12,0,0,0" />
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Feuille" Style="{StaticResource Text.Label}" />
                            <ComboBox x:Name="cboSheet" Width="160" Margin="0,0,18,0"
                                      SelectionChanged="CboSheet_SelectionChanged" />

                            <TextBlock Text="Ligne d'en-tête" Style="{StaticResource Text.Label}" />
                            <TextBox x:Name="txtHeaderRow" Text="1" Width="54" Margin="0,0,18,0"
                                     TextAlignment="Center" />

                            <TextBlock Text="Colonne du numéro" Style="{StaticResource Text.Label}" />
                            <ComboBox x:Name="cboPhoneColumn" Width="190" Margin="0,0,18,0"
                                      SelectionChanged="CboPhoneColumn_SelectionChanged" />

                            <TextBlock Text="Pays par défaut" Style="{StaticResource Text.Label}" />
                            <ComboBox x:Name="cboCountry" Width="230"
                                      SelectionChanged="CboCountry_SelectionChanged" />
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 2. Message -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeText}" />
                        </Border>
                        <TextBlock Text="Message" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="10,0,0,0">
                            <Run Text="{}{{Colonne}}" FontFamily="Consolas" Foreground="{DynamicResource Brush.AccentText}" /><Run Text=" insère une valeur, " />
                            <Run Text="{}{{Colonne|défaut}}" FontFamily="Consolas" Foreground="{DynamicResource Brush.AccentText}" /><Run Text=" une valeur de repli si la cellule est vide" />
                        </TextBlock>
                    </DockPanel>

                    <TextBox x:Name="txtMessage" Grid.Row="1" Grid.Column="0"
                             Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Padding="10,8" FontSize="13.5"
                             SpellCheck.IsEnabled="True" Language="fr-FR"
                             TextChanged="TxtMessage_TextChanged" />

                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Colonnes — double-clic pour insérer"
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                        <ListBox x:Name="lstColumns" Height="{Binding ActualHeight, ElementName=txtMessage}"
                                 MouseDoubleClick="LstColumns_MouseDoubleClick" />
                    </DockPanel>

                    <TextBlock x:Name="lblSmsInfo" Grid.Row="2" Grid.ColumnSpan="2"
                               Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 3. Destinataires -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12,18,14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="pbProgress" Width="180" Margin="16,0,10,0" />
                            <TextBlock x:Name="lblProgress" Style="{StaticResource Text.Muted}"
                                       FontWeight="SemiBold" MinWidth="44" />
                        </StackPanel>

                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeText}" />
                        </Border>
                        <TextBlock Text="Destinataires" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock x:Name="lblCounts" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" />
                    </DockPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="btnCheckAll" Content="Tout cocher" Click="BtnCheckAll_Click" />
                        <Button x:Name="btnUncheckAll" Content="Tout décocher"
                                Style="{StaticResource ToolButton}" Click="BtnUncheckAll_Click" />
                        <Button x:Name="btnMobilesOnly" Content="Ne garder que les mobiles"
                                Style="{StaticResource ToolButton}" Click="BtnMobilesOnly_Click" />
                        <Button x:Name="btnResetStatus" Content="Réinitialiser les statuts"
                                Style="{StaticResource ToolButton}" Click="BtnResetStatus_Click" />
                    </WrapPanel>

                    <DataGrid x:Name="dgRecipients"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              RowHeight="30" MinHeight="150">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowState}" Value="invalid">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Row.Invalid}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="landline">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Row.Landline}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="sending">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Row.Sending}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="sent">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Row.Sent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="failed">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Row.Failed}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Envoyer" Width="70"
                                                    Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Ligne" Width="60" IsReadOnly="True"
                                                Binding="{Binding LineNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Numéro source" Width="135" IsReadOnly="True"
                                                Binding="{Binding RawPhone}" />
                            <DataGridTextColumn Header="Normalisé" Width="150" IsReadOnly="True"
                                                Binding="{Binding Pretty}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Type" Width="95" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KindPill}">
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource KindPillText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Message" Width="*" IsReadOnly="True"
                                                Binding="{Binding Rendered}" />
                            <DataGridTemplateColumn Header="Statut" Width="150" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Détail" Width="210" IsReadOnly="True"
                                                Binding="{Binding Detail}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 4. Téléphone -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,10,18,10"
                    ToolTip="Débogage USB activé, câble branché, écran déverrouillé pendant l'envoi">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Style="{StaticResource StepBadge}">
                        <TextBlock Text="4" Style="{StaticResource StepBadgeText}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="Téléphone" Style="{StaticResource Text.CardTitle}" Margin="0,0,20,0" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
                        <TextBlock Text="Appareil" Style="{StaticResource Text.Label}" />
                        <ComboBox x:Name="cboDevice" Width="290"
                                  SelectionChanged="CboDevice_SelectionChanged" />
                        <Button x:Name="btnRefreshDevices" Content="Rafraîchir"
                                Style="{StaticResource ToolButton}" Click="BtnRefreshDevices_Click" />
                        <Button x:Name="btnPrepare" Content="Préparer le téléphone"
                                Style="{StaticResource ToolButton}" Click="BtnPrepare_Click" />
                    </StackPanel>

                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="adb" Style="{StaticResource Text.Label}" />
                        <Button DockPanel.Dock="Right" x:Name="btnBrowseAdb" Content="…" MinWidth="36"
                                Padding="0" Margin="8,0,0,0" Click="BtnBrowseAdb_Click" />
                        <TextBox x:Name="txtAdb" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- 5. Journal -->
            <Expander Grid.Row="4" x:Name="expLog" Header="Journal" IsExpanded="False" Margin="0,0,0,8">
                <TextBox x:Name="txtLog" IsReadOnly="True" Margin="0,8,0,0"
                         Background="{DynamicResource Brush.Console}"
                         Foreground="{DynamicResource Brush.ConsoleText}"
                         BorderThickness="0" Padding="12,10"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </Expander>
        </Grid>

        <!-- ================================================== Barre d'action -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnReport" Content="Exporter le rapport" Click="BtnReport_Click" />
                    <Button x:Name="btnStop" Content="Stop" IsEnabled="False"
                            Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Click="BtnStop_Click" />
                    <Button x:Name="btnSend" Content="ENVOYER" MinWidth="150" MinHeight="38"
                            FontSize="13.5" Padding="22,0"
                            Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Click="BtnSend_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Délai entre envois" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="txtDelay" Text="4000" Width="72" TextAlignment="Center" />
                    <TextBlock Text="ms" Style="{StaticResource Text.Label}" Margin="6,0,18,0" />

                    <CheckBox x:Name="chkDryRun" Content="Simulation (n'envoie rien)" IsChecked="True"
                              Margin="0,0,18,0" />

                    <TextBlock Text="Numéro de test" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="txtTestNumber" Width="150" />
                    <Button x:Name="btnSendTest" Content="Envoyer un test"
                            Style="{StaticResource ToolButton}" Click="BtnSendTest_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
