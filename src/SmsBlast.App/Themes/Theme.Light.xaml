<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème clair. Chaque clé existe aussi dans Theme.Dark.xaml. -->

    <SolidColorBrush x:Key="Brush.Window"        Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.Card"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border"        Color="#E2E6EE" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#C9D0DC" />
    <SolidColorBrush x:Key="Brush.BorderHover"   Color="#A9B3C6" />
    <SolidColorBrush x:Key="Brush.Text"          Color="#1B1F2A" />
    <SolidColorBrush x:Key="Brush.Muted"         Color="#6B7280" />
    <SolidColorBrush x:Key="Brush.Subtle"        Color="#F7F8FB" />
    <SolidColorBrush x:Key="Brush.Hover"         Color="#EEF1F6" />
    <SolidColorBrush x:Key="Brush.Overlay"       Color="#000000" />
    <SolidColorBrush x:Key="Brush.OnAccent"      Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent"        Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentSoft"    Color="#E8EFFD" />
    <SolidColorBrush x:Key="Brush.AccentText"    Color="#1E40AF" />
    <SolidColorBrush x:Key="Brush.Selection"     Color="#D6E3FB" />

    <SolidColorBrush x:Key="Brush.Danger"        Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerSoft"    Color="#FEE2E2" />
    <SolidColorBrush x:Key="Brush.DangerText"    Color="#991B1B" />
    <SolidColorBrush x:Key="Brush.DangerBorder"  Color="#F1B4B4" />

    <SolidColorBrush x:Key="Brush.Success"       Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.SuccessSoft"   Color="#DCFCE7" />
    <SolidColorBrush x:Key="Brush.SuccessText"   Color="#166534" />

    <SolidColorBrush x:Key="Brush.Warning"       Color="#D97706" />
    <SolidColorBrush x:Key="Brush.WarningSoft"   Color="#FEF3C7" />
    <SolidColorBrush x:Key="Brush.WarningText"   Color="#92400E" />

    <SolidColorBrush x:Key="Brush.InfoSoft"      Color="#E0E7FF" />
    <SolidColorBrush x:Key="Brush.InfoText"      Color="#3730A3" />

    <SolidColorBrush x:Key="Brush.Console"       Color="#1E293B" />
    <SolidColorBrush x:Key="Brush.ConsoleText"   Color="#E2E8F0" />

    <SolidColorBrush x:Key="Brush.GridLine"      Color="#EEF1F6" />
    <SolidColorBrush x:Key="Brush.Row.Invalid"   Color="#FFF4F4" />
    <SolidColorBrush x:Key="Brush.Row.Landline"  Color="#FFFBEB" />
    <SolidColorBrush x:Key="Brush.Row.Sending"   Color="#EFF6FF" />
    <SolidColorBrush x:Key="Brush.Row.Sent"      Color="#F0FDF4" />
    <SolidColorBrush x:Key="Brush.Row.Failed"    Color="#FEE2E2" />

    <SolidColorBrush x:Key="Brush.ScrollThumb"   Color="#C9D0DC" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#9AA5B8" />

</ResourceDictionary>
